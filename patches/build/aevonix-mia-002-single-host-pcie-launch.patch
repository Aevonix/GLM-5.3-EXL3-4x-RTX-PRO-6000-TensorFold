--- /dev/null
+++ b/scripts/start.sh
@@ -0,0 +1,34 @@
+#!/usr/bin/env bash
+set -euo pipefail
+: "${IMAGE:?set the built image tag}" "${MODEL_DIR:?set the checkpoint directory}" "${DRAFTER_DIR:?set the DSpark directory}"
+export TF_GLM_DENSE=${DENSE:-fp8} TF_GLM_KV=${KV:-fp8} TF_GLM_CP=${CP:-1}
+export TF_GLM_CP_GRAPHS=${TF_GLM_CP_GRAPHS:-$TF_GLM_CP} TF_GLM_MTP=0 TF_GLM_WIDE_GRAPHS=9
+export TF_GLM_HC_SPLIT=1 TF_GLM_PREFILL_OVERLAP=1 TF_GLM_CP_RAW_Q=0
+export TF_GLM_PREFILL_ROWS=${TF_GLM_PREFILL_ROWS:-$([[ $TF_GLM_CP == 1 ]] && echo 3072 || echo 2048)}
+export TF_GLM_COMM=nccl TENSORFOLD_NO_UPDATE_CHECK=1 TORCH_CUDA_ARCH_LIST=12.0 PYTHONUNBUFFERED=1
+export TF_MEMORY_LOG=1 TF_GLM_COPY_DRAFTS=1 TF_GLM_COPY_MAX=15 TF_GLM_COPY_HYBRID=1
+export TF_GLM_SHARED_PREFIX=1 TF_GLM_CLEAR_THINKING=0 TF_GLM_STREAM_SMOOTH=1 TF_GLM_STREAM_SMOOTH_MS=400
+export TENSORFOLD_NUCLEUS_UNION=1 TF_GLM_CACHE_GIB=1 TF_GLM_CACHE_ENTRIES=8
+export NCCL_P2P_LEVEL=SYS NCCL_IB_DISABLE=1 NCCL_SOCKET_IFNAME=lo NCCL_NET=Socket NCCL_NET_PLUGIN=none
+export NCCL_MIN_NCHANNELS=4 NCCL_MAX_NCHANNELS=4
+export TENSORFOLD_MEMORY_RESERVE_GIB=${MEMORY_RESERVE_GIB:-4}
+export TF_GLM_DISK_CACHE=${TF_GLM_DISK_CACHE:-}
+export TF_GLM_DISK_CACHE_TAG="dense-${TF_GLM_DENSE}-cp-${TF_GLM_CP}-p-${PARALLEL:-1}"
+: "${CACHE_DIR:=$PWD/cache}" "${LOG_DIR:=$PWD/logs}" "${RUN:=server}" "${CONTAINER_PREFIX:=glm53-port}"
+mkdir -p "$CACHE_DIR" "$LOG_DIR"
+pass=()
+while IFS= read -r key; do case "$key" in TF_*|TENSORFOLD_*|NCCL_*|TORCH_CUDA_ARCH_LIST|PYTHONUNBUFFERED) pass+=(-e "$key");; esac; done < <(compgen -e)
+cleanup() { trap - EXIT INT TERM; for rank in 0 1 2 3; do docker stop -t 10 "${CONTAINER_PREFIX}-r$rank" >/dev/null 2>&1 || true; done; }
+trap cleanup EXIT INT TERM
+for rank in 0 1 2 3; do
+ visible=$rank; for gpu in 0 1 2 3; do [[ $gpu == $rank ]] || visible+=,$gpu; done
+ mkdir -p "$CACHE_DIR/r$rank"
+ docker run --name "${CONTAINER_PREFIX}-r$rank" --rm --gpus all -e "CUDA_VISIBLE_DEVICES=$visible" --ipc host --network host \
+  --ulimit memlock=-1 --ulimit stack=67108864 "${pass[@]}" \
+  -v "$CACHE_DIR/r$rank:/cache" -v "$MODEL_DIR:/model:ro" -v "$DRAFTER_DIR:/drafter:ro" \
+  --entrypoint tensorfold "$IMAGE" serve /model --tp 4 --rank "$rank" --master 127.0.0.1 \
+  --master-port "${MASTER_PORT:-29591}" --name "${SERVED_NAME:-glm-5.3}" --host "${API_HOST:-127.0.0.1}" --port "${PORT:-8031}" \
+  --context "${CONTEXT:-32768}" --max-tokens "${MAX_TOKENS:-32768}" --thinking --parallel "${PARALLEL:-1}" --drafter /drafter \
+  > "$LOG_DIR/$RUN-rank$rank.log" 2>&1 &
+done
+wait -n
