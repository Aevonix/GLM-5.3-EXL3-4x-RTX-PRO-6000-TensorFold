+++ b/tests/test_cp_batch_draft.py
@@ -0,0 +1,69 @@
+import pytest
+import torch
+from tensorfold.families.glm5_next.cuda.batch_draft import settings, limits
+from tensorfold.families.glm5_next.cuda.dspark_multi import DSparkMulti
+from tensorfold.families.glm5_next.cuda.dflash2_multi import DraftRequest
+
+
+def test_batch_tables_are_bounded_and_disable_drafting(monkeypatch):
+    monkeypatch.setenv('TF_GLM_BATCH_VERIFY_ROWS', '9,12,12,12,10')
+    monkeypatch.setenv('TF_GLM_BATCH_DRAFT_DEPTH', '8,4,3,2,0')
+    rows, depths, _ = settings()
+    assert [limits(n, rows, depths) for n in range(1,6)] == [(9,8),(12,4),(12,3),(12,2),(10,0)]
+
+
+@pytest.mark.parametrize('key,value', [('TF_GLM_BATCH_VERIFY_ROWS','16,16'),
+    ('TF_GLM_BATCH_VERIFY_ROWS','16,16,16,16,4'), ('TF_GLM_BATCH_VERIFY_ROWS','17,16,16,16,16'),
+    ('TF_GLM_BATCH_DRAFT_DEPTH','8,8,8,8,-1'), ('TF_GLM_DSPARK_BATCH_BLOCKS','yes')])
+def test_invalid_batch_table_fails_before_collectives(monkeypatch,key,value):
+    monkeypatch.setenv(key,value)
+    with pytest.raises(ValueError):
+        settings()
+
+
+class FakeDrafter:
+    __module__ = 'tensorfold.families.glm5_next.cuda.dspark'
+
+    def __init__(self):
+        self.block, self.causal, self.gathered, self.top_k = 8, True, 1, 2
+        self.kc = [torch.zeros(2,32,4)]
+        self.vc = [torch.zeros(2,32,4)]
+        self.pos_dev = torch.zeros(1, dtype=torch.int64)
+        self.ids = torch.zeros(8, dtype=torch.int32)
+        self.ids_host = torch.zeros(1, dtype=torch.int32)
+        self.tap_in = torch.zeros(16,4)
+        self.tap_rows = 2
+        self.cand_n = 32
+        self.cand = torch.zeros(40)
+        self.cand_host = torch.zeros(40)
+        self.context_end = 0
+
+    def propose(self, pending, depth, sampling, confidence, **kwargs):
+        assert self.context_end == int(self.pos_dev[0])
+        return [self.block]*depth
+
+
+def test_short_blocks_share_committed_context_and_own_candidates(monkeypatch):
+    monkeypatch.setenv('TF_GLM_DSPARK_BATCH_BLOCKS','1')
+    md = DSparkMulti(FakeDrafter(), streams=2)
+    ctx = md.contexts[1]
+    ctx.context_end = 17
+    ctx.pos_dev[0] = 17
+    assert set(md.variants[1]) == {1,2,4,8}
+    for size, v in md.variants[1].items():
+        assert v.kc is ctx.kc and v.vc is ctx.vc and v.pos_dev is ctx.pos_dev
+        if size != 8:
+            assert v.cand.data_ptr() != ctx.cand.data_ptr()
+    for depth, block in [(1,1),(2,2),(3,4),(7,8)]:
+        assert md.propose([DraftRequest(ctx, 5, depth, None, 0.)]) == [[block]*depth]
+    ctx.context_end = 21
+    ctx.pos_dev[0] = 21
+    assert md.propose([DraftRequest(ctx, 5, 2, None, 0.)]) == [[2,2]]
+
+
+def test_noncausal_drafter_rejects_short_blocks(monkeypatch):
+    monkeypatch.setenv('TF_GLM_DSPARK_BATCH_BLOCKS','1')
+    d = FakeDrafter()
+    d.causal = False
+    with pytest.raises(ValueError, match='causal'):
+        DSparkMulti(d)
