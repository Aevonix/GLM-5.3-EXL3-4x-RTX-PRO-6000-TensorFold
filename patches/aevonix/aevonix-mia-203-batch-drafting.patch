+++ b/src/tensorfold/families/glm5_next/cuda/batch_draft.py
@@ -0,0 +1,32 @@
+"""Explicit batch-size policy for full-model speculative verification.
+
+Five entries address one through five active streams. Tables are deployment
+settings to measure, not a single-stream cost model extrapolated to a batch.
+"""
+import os
+
+
+def settings():
+    def table(name, default, minimum, maximum):
+        raw = os.environ.get(name, '').strip()
+        values = tuple(map(int, raw.split(','))) if raw else default
+        if len(values) != 5 or any(not lo <= x <= maximum for x, lo in zip(values, minimum)):
+            raise ValueError(f'{name}: five per-batch entries within the verification row budget')
+        return values
+    rows = table('TF_GLM_BATCH_VERIFY_ROWS', (16,)*5, range(1,6), 16)
+    depths = table('TF_GLM_BATCH_DRAFT_DEPTH', (8,)*5, (0,)*5, 8)
+    blocks = os.environ.get('TF_GLM_DSPARK_BATCH_BLOCKS', '0')
+    if blocks not in ('0', '1'):
+        raise ValueError('TF_GLM_DSPARK_BATCH_BLOCKS: 0 or 1')
+    return rows, depths, int(blocks)
+
+
+def limits(streams, rows, depths):
+    if not 1 <= streams <= 5:
+        raise ValueError('full-model batch needs one through five streams')
+    width = rows[streams-1]
+    return width, min(depths[streams-1], width//streams-1)
+
+
+def block_sizes(maximum):
+    return tuple(sorted({maximum, *(x for x in (1,2,4,8) if x <= maximum)}))
