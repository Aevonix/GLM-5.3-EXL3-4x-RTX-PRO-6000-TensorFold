+                    v.packed = v.cand[:v.cand_n].view(v.gathered, size, 2*v.top_k)
+                    v.hconf = v.cand[v.cand_n:]
+                    variants[size] = v
+            self.variants.append(variants)
 
     def nbytes(self) -> int:
         """The contexts' buffers (the weights are the drafter's)."""
-        return sum(context_bytes(c) for c in self.contexts)
+        return sum(context_bytes(c) for c in self.contexts) + sum(
+            v.cand.numel()*v.cand.element_size() for c, variants in zip(self.contexts, self.variants)
+            for v in variants.values() if v is not c)
 
     def reset(self) -> None:
         for c in self.contexts:
