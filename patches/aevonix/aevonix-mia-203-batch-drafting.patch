             c.reset()
-            n += len(c.tap_graphs) + 1
+            n += len(c.tap_graphs) + len(self.variants[c.slot])
         if torch.cuda.is_available():
             torch.cuda.synchronize()
         return n
@@ -118,6 +143,8 @@ class DSparkMulti:
         for c in self.contexts:
             c.block_graph = None
             c.tap_graphs = {}
+            for v in self.variants[c.slot].values():
+                v.block_graph = None
 
     def _own(self, ctx) -> None:
         if getattr(ctx, "owner", None) is not self:
@@ -139,7 +166,10 @@ class DSparkMulti:
             if depth < 1 or r.ctx.context_end == 0:
                 out.append([])
                 continue
-            out.append(list(r.ctx.propose(r.pending, depth, r.sampling, r.confidence, beta=r.beta,
