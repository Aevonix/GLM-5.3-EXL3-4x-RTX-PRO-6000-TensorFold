         self.contexts = [context(drafter) for _ in range(streams)]
+        from .batch_draft import settings, block_sizes
+        self.batch_blocks = bool(settings()[2])
+        if self.batch_blocks and not drafter.causal:
+            raise ValueError('batch-sized DSpark blocks require causal block attention')
+        self.variants = []
         for i, c in enumerate(self.contexts):
             c.owner, c.slot = self, i
+            variants = {c.block: c}
