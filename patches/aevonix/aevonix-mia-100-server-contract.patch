@@ -0,0 +1,209 @@
+"""CPU regressions for GLM's always-open reasoning template and native tool stream."""
+import json
+import pytest
+from tensorfold.cuda.chat_template import ChatTemplate
+from tensorfold.cuda.reply_text import parse_tool_calls
+from tensorfold.cuda.reply_text import GlmCallStreamer
+from tensorfold.families.glm5_next.cuda.app import ThinkingOffTemplate
+from tensorfold.server.cancellation import RequestCancelled
+from tests.test_cuda_admission import http_server, post
+from tests.test_cuda_stop_strings import END, Engine, body, events, ids, make_app
+
+TOOLS = [{"type": "function", "function": {"name": "write_file", "parameters": {
+    "type": "object", "properties": {"path": {"type": "string"}, "content": {"type": "string"},
+        "count": {"type": "integer"}, "options": {"type": "object"}, "flags": {"type": "array"},
+        "active": {"type": "boolean"}, "empty": {"type": "null"}}, "required": ["path"]}}}]
+GLM = ("{# 'low' 'high' 'max' #}{% for m in messages %}{{ m.role }}:{{ m.content }};{% endfor %}"
+       "effort={{ reasoning_effort|default('high') }};<|assistant|><think>")
+CALL = '<tool_call>write_file<arg_key>path</arg_key><arg_value>/tmp/example</arg_value></tool_call>'
+
+
+def app_for(tmp_path, text):
+    app = make_app(tmp_path, Engine(ids(text)))
+    (tmp_path / "tokenizer_config.json").write_text(json.dumps({"chat_template": GLM}))
+    app.template = ThinkingOffTemplate(ChatTemplate(tmp_path))
+    app._glm_calls = lambda: True
+    app.default_thinking = True
+    app.aliases = ("glm-alias",)
+    return app
+
+
+def decoded(text, stream):
+    if not stream:
+        data = json.loads(text)
+        choice = data["choices"][0]
+        return choice["message"], choice["finish_reason"]
+    chunks = events(text)
+    assert chunks[0]["choices"][0]["delta"] == {"role": "assistant"}
+    assert text.rstrip().endswith("data: [DONE]")
+    deltas = [c["choices"][0]["delta"] for c in chunks]
+    message = {k: "".join(d.get(k, "") for d in deltas) for k in ("content", "reasoning_content")}
+    return message, chunks[-1]["choices"][0]["finish_reason"]
+
+
+@pytest.mark.parametrize("stream", [False, True])
+@pytest.mark.parametrize("fields", [{"enable_thinking": False}, {"reasoning_effort": "none"},
+    {"chat_template_kwargs": {"enable_thinking": False}}, {"chat_template_kwargs": {"reasoning_effort": "none"}}])
+def test_off_is_low_effort_and_reasoning_never_becomes_content(tmp_path, stream, fields):
+    app = app_for(tmp_path, "café 日本語 😀" + END)
+    request = body(True, stream, **fields)
+    prepared = app.prepare(request, True)
+    assert not prepared.thinking and "<think></think>" in app.tok.decode(prepared.prompt)
+    with http_server(app) as port:
+        status, text = post(port, request, True)
+    message, finish = decoded(text, stream)
+    assert status == 200 and finish == "stop"
+    assert message["content"] == "café 日本語 😀"
+    assert not message.get("reasoning_content")
+
+
+@pytest.mark.parametrize("stream", [False, True])
+def test_stops_ignore_reasoning_and_hold_cross_chunk_answer_prefix(tmp_path, stream):
+    app = app_for(tmp_path, "quote |BETA in thought</think>ALPHA|BETA|GAMMA" + END)
+    with http_server(app) as port:
+        status, text = post(port, body(True, stream, stop="|BETA"), True)
+    message, finish = decoded(text, stream)
+    assert status == 200 and finish == "stop"
+    assert message["content"] == "ALPHA"
+    assert message["reasoning_content"] == "quote |BETA in thought"
+
+
+@pytest.mark.parametrize("stream", [False, True])
+def test_invalid_fields_are_typed_400_before_generation_or_sse(tmp_path, stream):
+    app = app_for(tmp_path, "unused")
+    bad = [{key: value} for key in ("max_tokens", "max_completion_tokens")
+           for value in (0, -1, 1.5, True, False, "8", 8.0)]
+    bad += [{"temperature": value} for value in (-0.1, 2.1, True, "NaN")]
+    bad += [{"top_p": value} for value in (-0.1, 1.1, True)]
+    bad += [{"enable_thinking": value} for value in ("false", None, 0, [])]
+    bad += [{"chat_template_kwargs": {"enable_thinking": value}} for value in ("false", None, 0)]
+    bad += [{"tool_choice": value} for value in ("banana", True, {}, {"type": "banana"},
+        {"type": "function", "function": {"name": "missing"}})]
+    bad += [{"model": value} for value in ("not-a-real-model", None, [], 1)]
+    schemas = ["oops", [], False, {"properties": []}, {"properties": {"x": "oops"}},
+        {"properties": {"x": {"type": "array", "items": {"type": "bogus"}}}}, {"required": "path"}]
+    bad += [{"tools": [{"type": "function", "function": {"name": "bad", "parameters": schema}}],
+             "tool_choice": "required"} for schema in schemas]
+    with http_server(app) as port:
+        for fields in bad:
+            status, text = post(port, body(True, stream, **fields), True)
+            assert status == 400, (fields, status, text)
+            assert json.loads(text)["error"]["type"] == "invalid_request_error"
+        for model in (app.served, "glm-alias"):
+            status, text = post(port, body(True, stream, model=model, max_completion_tokens=8), True)
+            assert status == 200
+    assert len(app.engine.calls) == 2
+
+
+@pytest.mark.parametrize("stream", [False, True])
+@pytest.mark.parametrize("single", [False, True])
+def test_every_tool_truncation_stays_out_of_content_and_finishes_length(tmp_path, stream, single):
+    for cut in range(1, len(CALL)):
+        text = "thought</think>" + CALL[:cut]
+        app = app_for(tmp_path, text)
+        heard = []
+        result = app.run(body(True, stream, tools=TOOLS, parallel_tool_calls=not single,
+                              max_tokens=len(ids(text))), True, lambda d: heard.append(d) or True)
+        assert result["finish"] == "length", cut
+        assert not result["content"] and not result["calls"], cut
+        assert not any(d.get("content") for d in heard), (cut, heard)
+
+
+def test_stop_and_disconnect_in_tool_value_never_flush_markup(tmp_path):
+    text = 'thought</think>' + CALL.replace('/tmp/example', '/tmp/STOPexample')
+    app = app_for(tmp_path, text)
+    heard = []
+    result = app.run(body(True, True, tools=TOOLS, stop="STOP"), True, lambda d: heard.append(d) or True)
+    assert result["finish"] == "stop" and not result["content"] and not result["calls"]
+    assert not any(d.get("content") for d in heard)
+    heard.clear()
+    def emit(delta):
+        heard.append(delta)
+        return not delta.get("tool_calls")
+    with pytest.raises(RequestCancelled):
+        app.run(body(True, True, tools=TOOLS), True, emit)
+    assert not any(d.get("content") for d in heard)
+    assert app.run(body(True, False, tools=TOOLS), True, lambda d: True)["finish"] == "tool_calls"
+
+
+@pytest.mark.parametrize("width", [1, 2, 7, 23, 4096])
+@pytest.mark.parametrize("single", [False, True])
+def test_glm_stream_escaping_types_ids_indexes_and_parallel_calls(width, single):
+    values = {"path": 'a"\\b\n日本語', "content": '\n  café 😀 "line"\\end\n ' * 12, "count": 42,
+              "options": {"nested": [1, True, None, "x"]}, "flags": ["a", 2], "active": True, "empty": None}
+    call = '<tool_call>write_file' + ''.join(
+        '<arg_key>' + k + '</arg_key><arg_value>' + (v if isinstance(v, str) else json.dumps(v)) + '</arg_value>'
+        for k, v in values.items()) + '</tool_call>'
+    text = call + CALL
+    streamer = GlmCallStreamer(TOOLS, max_calls=1 if single else None)
+    deltas, progress = [], []
+    for end in range(width, len(text) + width, width):
+        got = streamer.feed(text[:end])
+        deltas.extend(got)
+        progress.extend((end, d) for d in got)
+    calls = {}
+    for delta in deltas:
+        for c in delta["tool_calls"]:
+            item = calls.setdefault(c["index"], {"id": c.get("id"), "name": "", "arguments": ""})
+            for key, value in c["function"].items():
+                item[key] += value
+    assert sorted(calls) == ([0] if single else [0, 1])
+    assert len({c["id"] for c in calls.values()}) == len(calls)
+    assert json.loads(calls[0]["arguments"]) == values
+    if not single:
+        assert json.loads(calls[1]["arguments"]) == {"path": "/tmp/example"}
+    _, parsed = parse_tool_calls(text, TOOLS, max_calls=1 if single else None)
+    assert [json.loads(c["arguments"]) for c in calls.values()] == [json.loads(c["function"]["arguments"]) for c in parsed]
+    if width < len(call):
+        assert any(end < len(call) and len(d["tool_calls"][0]["function"].get("arguments", "")) > 1 for end, d in progress)
+
+
+@pytest.mark.parametrize("stream", [False, True])
+def test_completed_tools_with_off_and_streamed_ids_match_final(tmp_path, stream):
+    app = app_for(tmp_path, CALL + CALL + END)
+    heard = []
+    result = app.run(body(True, stream, tools=TOOLS, enable_thinking=False), True, lambda d: heard.append(d) or True)
+    sent_ids = [c["id"] for d in heard for c in d.get("tool_calls", []) if "id" in c]
+    assert not stream or sent_ids == [c["id"] for c in result["calls"]]
+    assert result["finish"] == "tool_calls" and not result["content"]
+    assert not result["reasoning"] and (not stream or len(set(sent_ids)) == 2)
+
+
+@pytest.mark.parametrize("suffix", ["<", "<tool", "<tool_call>write_file<arg_key>"])
+def test_length_after_complete_call_and_partial_next_call(tmp_path, suffix):
+    text = "thought</think>" + CALL + suffix
+    app = app_for(tmp_path, text)
+    result = app.run(body(True, True, tools=TOOLS, max_tokens=len(ids(text))), True, lambda d: True)
+    assert result["finish"] == "length" and len(result["calls"]) == 1 and not result["content"]
+
+
+@pytest.mark.parametrize("single", [False, True])
+def test_premature_outer_close_does_not_expose_incomplete_glm_arguments(tmp_path, single):
+    text = "thought</think><tool_call>write_file<arg_key>path</arg_key><arg_value>/tmp/x</tool_call>"
+    app = app_for(tmp_path, text)
+    heard = []
+    result = app.run(body(True, True, tools=TOOLS, max_tokens=len(ids(text)), parallel_tool_calls=not single),
+                     True, lambda d: heard.append(d) or True)
+    assert result["finish"] == "length" and not result["calls"] and not result["content"]
+    assert not any(d.get("content") for d in heard)
+
+
+@pytest.mark.parametrize("width", [1, 2, 7, 4096])
+def test_incremental_repaired_keys_match_nonstreamed_mia_parser(width):
+    # Preserve Mia's repair of a missing arg_key after an already streamed argument.
+    text = ('<tool_call>write_file<arg_key>path</arg_key><arg_value>/tmp/x</arg_value>'
+            'content</arg_key><arg_value>hello</arg_value></tool_call>')
+    streamer=GlmCallStreamer(TOOLS);arguments=""
+    for n in range(width,len(text)+width,width):
+        for d in streamer.feed(text[:n]):
+            arguments += d['tool_calls'][0]['function'].get('arguments','')
+    _, calls=parse_tool_calls(text,TOOLS)
+    assert json.loads(arguments)==json.loads(calls[0]['function']['arguments'])=={'path':'/tmp/x','content':'hello'}
+
+
+def test_reasoning_stop_does_not_disable_eos_tool_repair(tmp_path):
+    # Mia's existing EOS repair remains available when a stop appears only in thought.
+    app = app_for(tmp_path, 'quote STOP</think>'+CALL.removesuffix('</tool_call>')+END)
+    a=app.run(body(True, False, tools=TOOLS, stop='STOP'),True,lambda d:True)
+    assert a['finish']=='tool_calls' and a['reasoning']=='quote STOP'
+    assert json.loads(a['calls'][0]['function']['arguments'])=={'path':'/tmp/example'}
