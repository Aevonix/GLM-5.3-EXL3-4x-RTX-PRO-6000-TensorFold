+class PagedSection:
+    """Tensor-shaped file section with bounded raw-byte gather/scatter.
+
+    A checksum piece may end inside a row (for example 132-byte FP4X index
+    rows). Preserve both partial boundary rows on writes, with no conversion
+    of the packed bytes. At most one piece plus two rows is materialized.
+    """
+    def __init__(self, view, count):
+        if not 0 <= count <= view.shape[0]:
+            raise ValueError('snapshot outside paged extent')
+        self.view = view
+        self.shape = torch.Size((count, *view.shape[1:]))
+        self.dtype, self.device = view.dtype, view.device
+        self.is_cuda = self.device.type == 'cuda'
+
+    def numel(self):
+        return self.shape.numel()
+
+    def element_size(self):
+        return self.view.tensor.element_size()
+
+    def is_contiguous(self):
+        return True
+
+    def _piece(self, a, b):
+        if not 0 <= a <= b <= self.numel() * self.element_size():
+            raise ValueError('snapshot byte range outside section')
+        width = self.view.tensor[0].numel() * self.element_size()
+        lo, hi = a // width, -(-b // width)
+        rows = self.view.gather(hi - lo, lo)
+        return rows, lo, a - lo * width, b - lo * width
+
+    def read_bytes(self, a, b):
+        rows, _, start, end = self._piece(a, b)
+        return rows.reshape(-1).view(torch.uint8)[start:end]
+
+    def write_bytes(self, a, value):
+        rows, lo, start, end = self._piece(a, a + value.numel())
+        rows.reshape(-1).view(torch.uint8)[start:end].copy_(value)
+        self.view.write(lo, rows)
+
+
 class PagedArena(Arena):
     def __init__(self, rows, planes):
         super().__init__(rows, planes)
