diff --git a/src/tensorfold/families/glm5_next/cuda/paged_copy.py b/src/tensorfold/families/glm5_next/cuda/paged_copy.py
new file mode 100644
index 00000000..f6439095
--- /dev/null
+++ b/src/tensorfold/families/glm5_next/cuda/paged_copy.py
@@ -0,0 +1,38 @@
+"""Bit-preserving physical-page copies without intermediate index tensors."""
+import torch
+import triton as tr
+import triton.language as tl
+
+
+@tr.jit
+def _copy(SRC, DST, TABLE, BASE, START,
+          COUNT, WIDTH: tl.constexpr, PAGE_ROWS: tl.constexpr,
+          WRITE: tl.constexpr, BLOCK: tl.constexpr):
+    x = tl.program_id(0) * BLOCK + tl.arange(0, BLOCK)
+    row = x // WIDTH
+    local = BASE + START + row
+    physical = tl.load(TABLE + local // PAGE_ROWS, row < COUNT, other=0) * PAGE_ROWS + local % PAGE_ROWS
+    mapped = physical * WIDTH + x % WIDTH
+    source = x if WRITE else mapped
+    target = mapped if WRITE else x
+    value = tl.load(SRC + source, x < COUNT * WIDTH, other=0)
+    tl.store(DST + target, value, x < COUNT * WIDTH)
+
+
+def copy(view, count, start, value=None, *, write=False):
+    """Copy raw bytes, including every quantizer scale and the masked pad row."""
+    if not 0 <= start <= start + count <= view.shape[0]:
+        raise ValueError('paged copy outside extent')
+    plane = view.arena.planes[view.plane]
+    if value is None:
+        value = torch.empty((count, *view.shape[1:]), dtype=view.dtype, device=view.device)
+    if count == 0:
+        return value
+    if not value.is_contiguous() or not view.tensor.is_contiguous():
+        raise ValueError('paged byte-copy expects contiguous rows')
+    width = view.tensor[0].numel() * view.tensor.element_size()
+    source, target = (value, view.tensor) if write else (view.tensor, value)
+    _copy[(tr.cdiv(count * width, 1024),)](
+        source.view(torch.uint8), target.view(torch.uint8), view.arena.table,
+        view.base // plane.div, start, count, width, 2048 // plane.div, write, 1024)
+    return value
diff --git a/src/tensorfold/families/glm5_next/cuda/paged_cp.py b/src/tensorfold/families/glm5_next/cuda/paged_cp.py
new file mode 100644
index 00000000..aacaedf4
--- /dev/null
+++ b/src/tensorfold/families/glm5_next/cuda/paged_cp.py
@@ -0,0 +1,152 @@
+"""Exact paged-CP reference using one layer's bounded contiguous staging.
+
+Logical extents retain the scheduler's lifecycle; physical pages are independently
+addressed through a shared table. Kernels operate on a gathered per-layer view,
+then only newly written local rows scatter back. This avoids changing attention
+math and is deliberately a performance reference, not a claim of zero-cost paging.
+"""
+import os
+import torch
+from .pool import Arena, ALIGN
+
+
+def enabled():
+    return os.environ.get('TF_GLM_CP_PAGED', '0') == '1'
+
+
+class PagedView:
+    def __init__(self, arena, plane, base, size):
+        self.arena, self.plane = arena, plane
+        self.base, self.size = int(base), int(size)
+        self.tensor = arena.planes[plane].tensor
+        p = arena.planes[plane]
+        self.shape = torch.Size((size // p.div + p.pad, *self.tensor.shape[1:]))
+        self.dtype, self.device = self.tensor.dtype, self.tensor.device
+
+    def indices(self, start, count):
+        p = self.arena.planes[self.plane]
+        local = torch.arange(self.base // p.div + start, self.base // p.div + start + count,
+                             device=self.device, dtype=torch.int64)
+        page_rows = ALIGN // p.div
+        page = local // page_rows
+        return self.arena.table[page] * page_rows + local % page_rows
+
+    def gather(self, count=None, start=0, out=None):
+        count = self.shape[0] - start if count is None else count
+        if self.device.type == 'cuda' and os.environ.get('TF_GLM_CP_PAGED_KERNELS', '0') == '1':
+            from .paged_copy import copy
+            return copy(self, count, start, out)
+        return torch.index_select(self.tensor, 0, self.indices(start, count), out=out)
+
+    def write(self, start, value):
+        if not 0 <= start <= start + value.shape[0] <= self.shape[0]:
+            raise ValueError('paged write outside extent')
+        if self.device.type == 'cuda' and os.environ.get('TF_GLM_CP_PAGED_KERNELS', '0') == '1':
+            from .paged_copy import copy
+            copy(self, value.shape[0], start, value, write=True)
+            return
+        self.tensor.index_copy_(0, self.indices(start, value.shape[0]), value)
+
+    def clone(self):
+        return self.gather()
+
+    def __getitem__(self, key):
+        # Diagnostic/snapshot reads; live multi-stream snapshots retain extents,
+        # never materialize all target layers. Disk restore is refused in this mode.
+        if isinstance(key, slice) and key.step in (None, 1):
+            a, z, _ = key.indices(self.shape[0])
+            return self.gather(z-a, a)
+        return self.gather()[key]
+
+
+class PagedArena(Arena):
+    def __init__(self, rows, planes):
+        super().__init__(rows, planes)
+        if rows % ALIGN or any(ALIGN % p.div for p in planes):
+            raise ValueError('paged CP requires whole rank-aligned pages')
+        pages = rows // ALIGN
+        # Nonidentity mapping exercises every reader/writer, including extent moves.
+        # The final sentinel maps the arena's one masked pad row to its own storage.
+        self.host_table = list(reversed(range(pages))) + [pages]
+        self.table = torch.tensor(self.host_table, dtype=torch.int64, device=planes[0].tensor.device)
+
+    def view(self, i, base, size):
+        if base < 0 or base + size > self.rows:
+            raise ValueError('paged extent outside arena')
+        return PagedView(self, i, base, size)
+
+    def move(self, src, dst, n):
+        """Relocate ownership without copying KV; source-only pages become free.
+
+        The caller moves one extent into otherwise free space (possibly overlapping
+        itself). Swapping the displaced pages into the vacated logical addresses
+        preserves a bijection. A prefix branch uses copy(), retaining its source.
+        """
+        if n <= 0 or src == dst:
+            return
+        if min(src, dst) < 0 or max(src, dst) + n > self.rows or src % ALIGN or dst % ALIGN:
+            raise ValueError('invalid paged extent move')
+        count = -(-n // ALIGN)
+        a, b = src // ALIGN, dst // ALIGN
+        source, target = set(range(a, a+count)), set(range(b, b+count))
+        old = self.host_table
+        new = old.copy()
+        new[b:b+count] = old[a:a+count]
+        for vacated, displaced in zip(sorted(source-target), sorted(target-source)):
+            new[vacated] = old[displaced]
+        # All ranks apply the same host permutation; default-stream ordering keeps
+        # old attention reads before this update and the next gather after it.
+        self.table.copy_(torch.tensor(new, dtype=self.table.dtype, device=self.table.device))
+        self.host_table = new
+
+    def copy(self, src, dst, n):
+        if n <= 0 or src == dst:
+            return
+        if min(src, dst) < 0 or max(src, dst) + n > self.rows or src % ALIGN or dst % ALIGN:
+            raise ValueError('invalid paged extent copy')
+        # Bounded, overlap-safe copies for relocation and kept-prefix branching.
+        step = min(ALIGN, abs(dst-src))
+        starts = range(0,n,step) if dst < src else reversed(range(0,n,step))
+        for at in starts:
+            count=min(step,n-at)
+            for i,p in enumerate(self.planes):
+                nr=-(-count//p.div)
+                source=self.view(i,src+at,count)
+                target=self.view(i,dst+at,count)
+                target.write(0,source.gather(nr))
+
+
+def run(fn, layer, w, lc, kr, pos_dev, b, R, keys, host_pos, sparse_np, **kwargs):
+    if not isinstance(lc, PagedView):
+        return fn(layer,w,lc,kr,pos_dev,b,R,keys,host_pos,sparse_np,**kwargs)
+    if host_pos is None or sparse_np is not None:
+        raise ValueError('paged CP reference requires eager windows and a host position')
+    G,rank=int(w.meta['cp']),int(w.rank)
+    # All ranks stage identical shapes, including ranks with one fewer valid row.
+    count=min(lc.shape[0],-(-(host_pos+R)//G)+1)
+    held=getattr(b,'paged_buffers',None)
+    if held is None:
+        held=b.paged_buffers={}
+    views=[lc,kr,keys]
+    flat=[]
+    for name,v in zip(('latent','rope','index'),views):
+        if v is None:
+            flat.append(None);continue
+        # Match the admitted extent, not the growing prefix. Returning its full
+        # shape also lets the unchanged CP KV-gather scratch allocate once.
+        cap=v.shape[0]
+        buf=held.get(name)
+        if buf is None or buf.shape[0]<cap or buf.dtype!=v.dtype:
+            held.pop(name, None)
+            buf = None  # release the old allocation before requesting its replacement
+            held[name]=buf=torch.empty((cap,*v.shape[1:]),dtype=v.dtype,device=v.device)
+        v.gather(count,out=buf[:count])
+        flat.append(buf[:cap])
+    result=fn(layer,w,*flat[:2],pos_dev,b,R,flat[2],host_pos,sparse_np,**kwargs)
+    lo=max(0,(host_pos+G-1-rank)//G)
+    hi=max(0,(host_pos+R+G-1-rank)//G)
+    if hi>lo:
+        for view,value in zip(views,flat):
+            if view is not None:
+                view.write(lo,value[lo:hi])
+    return result
