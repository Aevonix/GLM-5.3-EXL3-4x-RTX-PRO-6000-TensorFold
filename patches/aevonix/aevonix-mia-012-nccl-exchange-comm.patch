+def _loaded_path(name: str = "libnccl.so") -> str | None:
+    """The file of the loaded library named ``name``* (libnccl.so, libnccl.so.2, ...; not NCCL's plugins such as
+    libnccl-net-*.so) in this process's memory map, or None."""
+
+    try:
+        with open("/proc/self/maps") as f:
+            for line in f:
+                path = line.split()[-1] if line.strip() else ""
+                if os.path.basename(path).startswith(name):
+                    return path
+    except OSError:
+        pass
+    return None
+
+
+def _second_library(lib: ctypes.CDLL) -> ctypes.CDLL:
+    """A second, independent instance of the loaded NCCL library (a private copy of its file, mapped on its own, so it
+    keeps its own once-a-process settings); the copy is unlinked once mapped."""
+
+    import shutil
+    import tempfile
+
+    src = _loaded_path() or getattr(lib, "_name", "")
+    if not src or not os.path.exists(src):
+        raise RuntimeError("TF_NCCL_EXCHANGE_ENV: cannot find the loaded NCCL library's file to copy")
+    tmp = tempfile.mkdtemp(prefix="tf-nccl-exchange-")
+    dst = os.path.join(tmp, "libnccl-exchange.so.2")
+    shutil.copy2(os.path.realpath(src), dst)
+    try:
+        return ctypes.CDLL(dst, mode=getattr(os, "RTLD_LOCAL", 0) | getattr(os, "RTLD_NOW", 2))
+    finally:
+        os.unlink(dst)
+        os.rmdir(tmp)
+
+
+def exchange_env(value: str | None = None) -> dict[str, str]:
+    """TF_NCCL_EXCHANGE_ENV: NCCL_* settings (space separated NAME=VALUE) for the send/receive communicator; empty: off."""
+
+    value = (os.environ.get("TF_NCCL_EXCHANGE_ENV", "") if value is None else value).strip()
+    out: dict[str, str] = {}
+    for item in value.split():
+        name, eq, setting = item.partition("=")
+        if not eq or not name.startswith("NCCL_") or not name.replace("_", "").isalnum():
+            raise ValueError(f"TF_NCCL_EXCHANGE_ENV: NCCL_NAME=value items separated by spaces, not {item!r}")
+        out[name] = setting
+    return out
+
