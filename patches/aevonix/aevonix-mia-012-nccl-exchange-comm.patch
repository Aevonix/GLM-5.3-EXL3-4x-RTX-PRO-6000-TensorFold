index 00000000..8af2de84
--- /dev/null
+++ b/tests/test_nccl_exchange_settings.py
@@ -0,0 +1,63 @@
+"""Separate exchange settings preserve gather dispatch and the communicator contract."""
+from types import SimpleNamespace
+import pytest
+
+torch=pytest.importorskip('torch')
+from tensorfold.cuda import comm
+
+@pytest.mark.parametrize('enabled',[False,True])
+def test_constructor_preserves_timeout_and_custom_rendezvous(monkeypatch,enabled):
+    primary,exchange=object(),object();seen=[];stores=[]
+    monkeypatch.setattr(comm,'_library',lambda:primary)
+    monkeypatch.setattr(comm,'_second_library',lambda lib:exchange)
+    monkeypatch.setattr(comm,'_bind',lambda lib:None)
+    monkeypatch.setattr(torch.cuda,'current_device',lambda:0)
+    monkeypatch.setattr(torch.distributed,'TCPStore',lambda *a,**kw:stores.append((a,kw)) or object())
+    monkeypatch.setenv('NCCL_P2P_DISABLE','0')
+    if enabled:monkeypatch.setenv('TF_NCCL_EXCHANGE_ENV','NCCL_P2P_DISABLE=1')
+    else:monkeypatch.delenv('TF_NCCL_EXCHANGE_ENV',raising=False)
+    def initialize(self,lib,key):
+        import os
+        seen.append((lib,key,os.environ['NCCL_P2P_DISABLE']))
+        return key
+    monkeypatch.setattr(comm.NCCL,'_init',initialize)
+    c=comm.NCCL(0,4,'192.0.2.1',29582,timeout_s=123,key='custom')
+    assert stores[0][0]==('192.0.2.1',29582,4,True)
+    assert stores[0][1]['timeout'].total_seconds()==123
+    assert seen==([(primary,'custom','0'),(exchange,'custom_exchange','1')] if enabled else [(primary,'custom','0')])
+    assert c.lib is primary and c.xlib is (exchange if enabled else primary)
+    import os
+    assert os.environ['NCCL_P2P_DISABLE']=='0'
+
+def test_environment_restored_if_second_library_fails(monkeypatch):
+    monkeypatch.setattr(comm,'_library',object)
+    monkeypatch.setattr(comm,'_bind',lambda lib:None)
+    monkeypatch.setattr(comm.NCCL,'_init',lambda self,lib,key:key)
+    monkeypatch.setattr(torch.cuda,'current_device',lambda:0)
+    monkeypatch.setattr(torch.distributed,'TCPStore',lambda *a,**kw:object())
+    monkeypatch.setenv('TF_NCCL_EXCHANGE_ENV','NCCL_P2P_DISABLE=1 NCCL_PROTO=LL')
+    monkeypatch.setenv('NCCL_P2P_DISABLE','0');monkeypatch.delenv('NCCL_PROTO',raising=False)
+    def fail(lib):raise RuntimeError('copy failed')
+    monkeypatch.setattr(comm,'_second_library',fail)
+    with pytest.raises(RuntimeError,match='copy failed'):comm.NCCL(0,4,'192.0.2.1',29582)
+    import os
+    assert os.environ['NCCL_P2P_DISABLE']=='0' and 'NCCL_PROTO' not in os.environ
+
+def test_gather_and_asymmetric_exchange_use_their_own_libraries(monkeypatch):
+    class Lib:
+        def __init__(self):self.calls=[]
+        def __getattr__(self,name):
+            def call(*args):self.calls.append((name,args));return 0
+            return call
+    c=object.__new__(comm.NCCL);c.rank=0;c.world=4;c.lib=Lib();c.xlib=Lib();c.comm='gather';c.xcomm='exchange'
+    monkeypatch.setattr(torch.cuda,'current_stream',lambda:SimpleNamespace(cuda_stream=7))
+    c.all_gather(torch.zeros(3),torch.zeros(12))
+    c.exchange([torch.zeros(3),torch.zeros(0)],[torch.zeros(5),torch.zeros(2,dtype=torch.int32)],3)
+    assert [n for n,a in c.lib.calls]==['ncclAllGather']
+    assert c.lib.calls[0][1][-2:]==('gather',7)
+    assert [(n,a[1],a[3],a[-2:]) for n,a in c.xlib.calls if n in ('ncclSend','ncclRecv')]==[
+        ('ncclSend',3,3,('exchange',7)),('ncclRecv',5,3,('exchange',7)),('ncclRecv',2,3,('exchange',7))]
+
+def test_invalid_environment_fields_fail_before_library_loading():
+    for value in ('PATH=1','NCCL_BAD-NAME=1','NCCL_PROTO'):
+        with pytest.raises(ValueError):comm.exchange_env(value)
