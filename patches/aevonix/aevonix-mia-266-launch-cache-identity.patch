+def launch_digest(environ=None):
+    """Conservative identity for kernel/transport controls omitted by the legacy
+    positional settings list. Cache budgets and I/O policy do not change KV bits.
+    """
+    env = os.environ if environ is None else environ
+    prefixes = ("TF_GLM_", "TF_MIA_", "TF_NCCL_", "NCCL_")
+    excluded = ("TF_GLM_DISK_", "TF_GLM_HOST_", "TF_GLM_CACHE_")
+    values = {k: v for k, v in env.items()
+              if (k.startswith(prefixes) or k in ("TENSORFOLD_NUCLEUS_UNION", "TORCH_CUDA_ARCH_LIST"))
+              and not k.startswith(excluded)}
+    return hashlib.sha256(json.dumps(values, sort_keys=True, separators=(",", ":")).encode()).hexdigest()
+
