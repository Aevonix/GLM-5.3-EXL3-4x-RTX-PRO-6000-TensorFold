diff --git a/src/tensorfold/families/glm5_next/cuda/page_address.py b/src/tensorfold/families/glm5_next/cuda/page_address.py
new file mode 100644
index 00000000..4d073e6f
--- /dev/null
+++ b/src/tensorfold/families/glm5_next/cuda/page_address.py
@@ -0,0 +1,28 @@
+"""Integer-only logical-to-physical addressing for native paged CP decode."""
+import triton
+import triton.language as tl
+
+
+@triton.jit
+def physical_rows(rows, valid, TABLE, PBASE, DESC, PAGE: tl.constexpr):
+    if PAGE:
+        base = tl.load(DESC).to(tl.int64) if DESC is not None else PBASE
+        local = base + rows
+        return tl.load(TABLE + local // PAGE, valid, other=0) * PAGE + local % PAGE
+    else:
+        return rows
+
+
+class NativeView:
+    def __init__(self, view, descriptor=None):
+        self.tensor = view.tensor
+        self.shape, self.dtype, self.device = view.shape, view.dtype, view.device
+        plane = view.arena.planes[view.plane]
+        self.page = dict(TABLE=view.arena.table, PBASE=view.base // plane.div,
+                         DESC=descriptor, PAGE=2048 // plane.div)
+
+
+def unwrap(value):
+    if isinstance(value, NativeView):
+        return value.tensor, value.page
+    return value, {}
