+"""Native/reference kernel identity; CUDA tests need a permitted GPU window."""
+from types import SimpleNamespace
+
+import pytest
+import torch
+import triton
+import triton.language as tl
+
+from tensorfold.families.glm5_next.cuda.page_address import NativeView, physical_rows
+from tensorfold.families.glm5_next.cuda.paged_cp import PagedArena
+from tensorfold.families.glm5_next.cuda.pool import Plane
+
+
+@triton.jit
+def _addresses(ROWS, OUT, TABLE, BASE, DESC, PAGE: tl.constexpr, N: tl.constexpr, B: tl.constexpr):
+    i = tl.arange(0, B)
+    rows = tl.load(ROWS+i, i < N, other=0)
+    mapped = physical_rows(rows, i < N, TABLE, BASE, DESC, PAGE)
+    tl.store(OUT+i, mapped, i < N)
+
+
+def test_integer_addressing_moves_and_dynamic_extents():
+    # Runs with TRITON_INTERPRET=1 on CPU, including nonidentity page tables.
+    arena = PagedArena(16384, [Plane(torch.zeros((4097, 1)), 4, 1)])
+    rows = torch.tensor([0, 1, 510, 511, 512, 513, 1023, 1024], dtype=torch.int64)
+    out = torch.empty_like(rows)
+    desc = torch.tensor([512, 2049], dtype=torch.int32)
+    _addresses[(1,)](rows, out, arena.table, 0, desc, 512, rows.numel(), 8)
+    view = arena.view(0, 2048, 8192)
+    expected = view.indices(0, 1025).index_select(0, rows)
+    assert torch.equal(out, expected)
+    arena.move(2048, 0, 8192)
+    desc[0] = 0
+    _addresses[(1,)](rows, out, arena.table, 512, desc, 512, rows.numel(), 8)
+    assert torch.equal(out, expected)
+
+
+@pytest.mark.skipif(not torch.cuda.is_available(), reason='native kernel identity requires CUDA')
+@pytest.mark.parametrize('rank', range(4))
+@pytest.mark.parametrize('position', [2039, 2047, 8190, 131060])
+def test_native_writes_selection_and_attention_equal_staging(rank, position):
+    from tensorfold.families.glm5_next.cuda import dcp, dsa_full, latent
+
+    torch.manual_seed(73)
+    dev, G, R, H, LW, RD, ID, IH = 'cuda', 4, 4, 16, 512, 64, 128, 32
+    capacity = 133120
+    pool = capacity + 4096
+    planes = [Plane(torch.zeros((pool//G+1, LW+16), dtype=torch.uint8, device=dev), G, 1),
+              Plane(torch.randn((pool//G+1, RD), dtype=torch.bfloat16, device=dev), G, 1),
+              Plane(torch.randn((pool//G+1, ID), dtype=torch.bfloat16, device=dev), G, 1)]
+    latent.latent_write(torch.randn((pool//G+1, LW), dtype=torch.bfloat16, device=dev),
+                        planes[0].tensor, torch.zeros(1, dtype=torch.int32, device=dev))
+    arena = PagedArena(pool, planes)
+    views = [arena.view(i, 2048, capacity) for i in range(3)]
+    pos = torch.tensor([position], dtype=torch.int32, device=dev)
+    desc = torch.tensor([2048//G, capacity//G+1], dtype=torch.int32, device=dev)
+    native = [NativeView(v, desc) for v in views]
+    flat = [v.gather() for v in views]
+    lat = torch.randn((R, LW), dtype=torch.bfloat16, device=dev)
+    key = torch.randn((R, RD), dtype=torch.bfloat16, device=dev)
+    raw = torch.randn((R, ID), dtype=torch.bfloat16, device=dev)
+    freq = torch.randn((RD//2,), dtype=torch.float32, device=dev)
+    ln_w = torch.randn((ID,), dtype=torch.bfloat16, device=dev)
+    ln_b = torch.randn_like(ln_w)
+    for lc, kr, ik in (flat, native):
+        latent.latent_write(lat, lc, pos, cp=G, rank=rank)
+        dsa_full.k_rope_write(key, kr, pos, freq, cp=G, rank=rank, latent=lc)
+        dsa_full.index_write(raw, ln_w, ln_b, ik, pos, freq, cp=G, rank=rank)
+    for expected, view in zip(flat, views):
+        assert torch.equal(expected, view.gather())
+    qi = torch.randn((R, IH*ID), dtype=torch.bfloat16, device=dev)
+    wt = torch.randn((R, IH), dtype=torch.bfloat16, device=dev)
+    cols = (position+R+G-1)//G
+    candidates = [dcp.select_local(qi, wt, ik, rank, G, pos, R, cols=cols) for ik in (flat[2], native[2])]
+    assert torch.equal(*candidates)
+    # Ordered local slots straddle pages; partials/LSE must preserve every bit.
+    slots = torch.arange(2048, dtype=torch.int32, device=dev).expand(R, -1).contiguous()
+    counts = torch.full((R,), min(2048, (position+1)//G), dtype=torch.int32, device=dev)
+    qa = torch.randn((R,H,LW), dtype=torch.bfloat16, device=dev)
+    qp = torch.randn((R,H,RD), dtype=torch.bfloat16, device=dev)
+    outputs = [dcp.attention_partial(qa, qp, lc, kr, slots, counts, .1)
+               for lc, kr in ((flat[0],flat[1]), (native[0],native[1]))]
+    for expected, actual in zip(*outputs):
+        assert torch.equal(expected, actual)
