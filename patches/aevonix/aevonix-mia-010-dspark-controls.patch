diff --git a/tests/test_glm_dspark_tuning.py b/tests/test_glm_dspark_tuning.py
new file mode 100644
index 00000000..f5316504
--- /dev/null
+++ b/tests/test_glm_dspark_tuning.py
@@ -0,0 +1,32 @@
+"""Draft controls select calibrated costs and stay scoped to DSpark."""
+from types import SimpleNamespace
+import pytest
+from tensorfold.families.glm5_next.cuda.engine import GlmEngine
+
+def engine(block=8):
+    drafter=type('StubDrafter',(),{'__module__':'tensorfold.families.glm5_next.cuda.dspark'})()
+    drafter.block=block
+    return SimpleNamespace(drafter=drafter,costs={'verify':(20.,24.,27.,30.,33.,36.,39.,42.,45.),'block':1.,'taps_row':.25})
+
+@pytest.mark.parametrize('mode',['cost','fixed'])
+@pytest.mark.parametrize('block,most,expected',[(8,8,8),(4,8,4),(8,3,3)])
+def test_controls_bound_depth_and_enable_cost_selection(monkeypatch,mode,block,most,expected):
+    monkeypatch.setenv('TF_GLM_DSPARK_MOST',str(most));monkeypatch.setenv('TF_GLM_DSPARK_POLICY',mode)
+    policy=GlmEngine._f_policy(engine(block))
+    assert policy.most==expected and policy.fixed and policy.learned
+    if mode=='cost':
+        assert policy.round_ms==(21.25,25.25,28.25,31.25,34.25,37.25,40.25,43.25,46.25)
+        assert policy.chain_rule['round_ms']==policy.round_ms
+    else:assert policy.round_ms is None and policy.chain_rule=={}
+
+@pytest.mark.parametrize('name,value',[('TF_GLM_DSPARK_MOST','0'),('TF_GLM_DSPARK_MOST','9'),('TF_GLM_DSPARK_POLICY','unknown')])
+def test_invalid_controls_are_rejected(monkeypatch,name,value):
+    monkeypatch.delenv('TF_GLM_DSPARK_MOST',raising=False);monkeypatch.delenv('TF_GLM_DSPARK_POLICY',raising=False)
+    monkeypatch.setenv(name,value)
+    with pytest.raises(ValueError):GlmEngine._f_policy(engine())
+
+def test_other_drafters_keep_their_default_policy(monkeypatch):
+    monkeypatch.setenv('TF_GLM_DSPARK_MOST','0')
+    value=engine();value.drafter=SimpleNamespace(block=8)
+    policy=GlmEngine._f_policy(value)
+    assert policy.most==5 and policy.confidence==.3 and policy.round_ms is None and not policy.learned
