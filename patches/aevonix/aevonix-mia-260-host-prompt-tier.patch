+"""Bounded pageable read-through cache; all budgets are per engine rank.
+
+The request thread is the sole allocator. Only completely verified reads are
+published; every hit passes the same section checksums as a disk read.
+"""
+from collections import OrderedDict
+from pathlib import Path
+import threading
+
+
+class HostTier:
+    def __init__(self, budget=0, *, world=1, reserve=48 << 30):
+        self.budget = max(0, int(budget))
+        self.world, self.reserve = max(1, int(world)), max(0, int(reserve))
+        self.entries = OrderedDict()
+        self.held = 0
+        self.lock = threading.RLock()
+        self.hits = self.misses = self.evictions = self.pressure = self.failed = 0
+
+    @staticmethod
+    def available():
+        """Host and cgroup headroom, including ancestor limits; fail closed."""
+        try:
+            available = next(int(s.split()[1]) * 1024 for s in
+                             Path('/proc/meminfo').read_text().splitlines()
+                             if s.startswith('MemAvailable:'))
+            for line in Path('/proc/self/cgroup').read_text().splitlines():
+                _, controllers, name = line.split(':', 2)
+                if not controllers:
+                    root, limit, current = Path('/sys/fs/cgroup'), 'memory.max', 'memory.current'
+                elif 'memory' in controllers.split(','):
+                    root, limit, current = Path('/sys/fs/cgroup/memory'), 'memory.limit_in_bytes', 'memory.usage_in_bytes'
+                else:
+                    continue
+                path = root / name.lstrip('/')
+                # A cgroup namespace can expose this process at the mount root.
+                if not path.exists():
+                    path = root
+                while path == root or root in path.parents:
+                    if (path / limit).exists():
+                        value = (path / limit).read_text().strip()
+                        if value != 'max':
+                            available = min(available, max(0, int(value) - int((path / current).read_text())))
+                    if path == root:
+                        break
+                    path = path.parent
+            return available
+        except (OSError, ValueError, StopIteration):
+            return 0
+
+    @staticmethod
+    def key(path):
+        path = Path(path)
+        st = path.stat()
+        return (str(path), st.st_dev, st.st_ino, st.st_size, st.st_mtime_ns, st.st_ctime_ns)
+
+    def _evict(self):
+        _, old = self.entries.popitem(last=False)
+        self.held -= len(old)
+        self.evictions += 1
+
+    def trim(self):
+        with self.lock:
+            while self.entries and self.available() < self.reserve:
+                self._evict()
+                self.pressure += 1
+
+    def discard(self, key):
+        with self.lock:
+            old = self.entries.pop(key, None)
+            if old is not None:
+                self.held -= len(old)
+
+    def get(self, key):
+        self.trim()
+        with self.lock:
+            # Replacing a file must not leave its previous allocation stranded.
+            for old in list(self.entries):
+                if old[0] == key[0] and old != key:
+                    self.discard(old)
+            value = self.entries.get(key)
+            if value is not None:
+                self.entries.move_to_end(key)
+                self.hits += 1
+            else:
+                self.misses += 1
+            return value
+
+    def allocate(self, size):
+        self.trim()
+        if not self.budget or size > self.budget or size < 0:
+            return None
+        with self.lock:
+            while self.entries and self.held + size > self.budget:
+                self._evict()
+            if self.available() < self.world * size + self.reserve:
+                self.pressure += 1
+                return None
+        try:
+            return bytearray(size)
+        except (MemoryError, OverflowError):
+            self.failed += 1
+            return None
+
+    def publish(self, key, value):
+        with self.lock:
+            self.trim()
+            if len(value) > self.budget or self.available() < self.reserve:
+                return
+            self.discard(key)
+            while self.entries and self.held + len(value) > self.budget:
+                self._evict()
+            self.entries[key] = value
+            self.held += len(value)
+
+    def clear(self):
+        with self.lock:
+            self.entries.clear()
+            self.held = 0
+
+    def stats(self):
+        return dict(bytes=self.held, budget_bytes=self.budget, entries=len(self.entries),
+                    hits=self.hits, misses=self.misses, evictions=self.evictions,
+                    pressure=self.pressure, allocation_failures=self.failed)
