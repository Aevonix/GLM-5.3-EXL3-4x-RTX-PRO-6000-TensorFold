+def validate_full_dflash(draft_dir, model_dir, *, parallel: int = 1) -> None:
+    """Accept only a DFlash2 checkpoint trained for this full target, before connecting ranks."""
+    d = json.loads((Path(draft_dir) / "config.json").read_text())
+    t = json.loads((Path(model_dir) / "config.json").read_text())
+    dc = d.get("dflash_config") or {}
+    taps = dc.get("target_layer_ids", [])
+    if ("DFlash2DraftModel" not in d.get("architectures", [])
+            or d.get("hidden_size") != t.get("hidden_size")
+            or d.get("vocab_size") != t.get("vocab_size")
+            or d.get("num_target_layers") != t.get("num_hidden_layers")
+            or not taps or len(set(taps)) != len(taps)
+            or any(not isinstance(i, int) or not 0 <= i < t["num_hidden_layers"] for i in taps)):
+        raise ValueError("full GLM DFlash2 requires matching hidden size, vocabulary, target layers and valid taps")
+    if parallel != 1:
+        raise ValueError("full GLM DFlash2 currently supports --parallel 1; multi-request validation is pending")
