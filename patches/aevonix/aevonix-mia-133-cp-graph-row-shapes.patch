+def padded_segments(segments, maximum, dense_limit):
+    """Bound row-shape variety without crossing a cache or attention boundary.
+
+    Extra causal rows are never returned or committed. Copy windows larger than
+    a stream's equal share retain their original shapes.
+    """
+    if len(segments) == 1:
+        return segments  # sixteen solo row counts already fit the bounded cache
+    share = maximum // len(segments)
+    if all(len(s.tokens) == 1 for s in segments) or any(len(s.tokens) > share for s in segments):
+        return segments
+    if any(s.st.pos + share > s.st.capacity or
+           s.st.pos < dense_limit < s.st.pos + share for s in segments):
+        return segments
+    return [Segment(s.st, s.tokens + [s.tokens[-1]] * (share - len(s.tokens))) for s in segments]
 
 
