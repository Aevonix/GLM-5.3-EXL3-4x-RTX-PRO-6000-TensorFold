diff --git a/tests/test_cp_graph_shapes.py b/tests/test_cp_graph_shapes.py
new file mode 100644
index 00000000..58b46eb4
--- /dev/null
+++ b/tests/test_cp_graph_shapes.py
@@ -0,0 +1,32 @@
+from types import SimpleNamespace
+
+from tensorfold.families.glm5_next.cuda.cp_graphs import padded_segments
+from tensorfold.families.glm5_next.cuda.verify import Segment
+
+
+def segment(rows, pos=100, capacity=8192):
+    return Segment(SimpleNamespace(pos=pos, capacity=capacity), list(range(rows)))
+
+
+def test_equal_share_retains_real_tokens_and_ownership():
+    original = [segment(2), segment(7)]
+    padded = padded_segments(original, 16, 2048)
+    assert [len(s.tokens) for s in padded] == [8, 8]
+    for given, actual in zip(original, padded):
+        assert actual.st is given.st
+        assert actual.tokens[:len(given.tokens)] == given.tokens
+    assert [len(s.tokens) for s in original] == [2, 7]
+
+
+def test_boundaries_and_large_copy_windows_keep_original_shapes():
+    for original in ([segment(1), segment(1)], [segment(12), segment(2)],
+                     [segment(2, pos=2045), segment(2)],
+                     [segment(2, pos=8190), segment(2)]):
+        assert padded_segments(original, 16, 2048) is original
+
+
+def test_five_streams_fit_total_row_budget_without_padding_solo():
+    assert [len(s.tokens) for s in padded_segments([segment(2) for _ in range(5)], 16, 2048)] == [3]*5
+    for rows in range(1,17):
+        solo = [segment(rows)]
+        assert padded_segments(solo, 16, 2048) is solo
