--- /dev/null
+++ b/src/tensorfold/families/glm5_next/cuda/memory_receipt.py
@@ -0,0 +1,128 @@
+"""Opt-in physical-storage receipt; alias views and shared weights are counted once."""
+from __future__ import annotations
+import json
+import os
+import signal
+import threading
+from collections import defaultdict
+import torch
+
+
+_requested = False
+_installed = False
+MEMORY_SIGNAL = signal.SIGUSR2  # SIGUSR1 belongs to server.stacks / faulthandler.
+
+
+def _request(signum, frame):
+    # Signal handlers only publish a flag. CUDA work runs on the engine thread.
+    global _requested
+    _requested = True
+
+
+def requested_receipt(engine):
+    global _requested
+    if _requested:
+        _requested = False
+        receipt(engine, "requested")
+
+
+
+def _install_handler():
+    global _installed
+    if threading.current_thread() is threading.main_thread():
+        signal.signal(MEMORY_SIGNAL, _request)
+        _installed = True
+
+
+def receipt(engine, stage):
+    if os.environ.get('TF_GLM_MEMORY_RECEIPT', '0') != '1':
+        return
+    if stage == 'ready':
+        _install_handler()
+    torch.cuda.synchronize()
+    seen_objects, seen_storage = set(), set()
+    totals = defaultdict(int)
+    def walk(obj, category, path=''):
+        if isinstance(obj, torch.Tensor):
+            if obj.device.type != 'cuda':
+                return
+            storage = obj.untyped_storage()
+            key = (obj.device.index, storage.data_ptr())
+            if key not in seen_storage:
+                seen_storage.add(key)
+                totals[category] += storage.nbytes()
+            return
+        if obj is None or isinstance(obj, (str, bytes, int, float, bool, type)):
+            return
+        if id(obj) in seen_objects:
+            return
+        seen_objects.add(id(obj))
+        if isinstance(obj, dict):
+            items = obj.items()
+        elif isinstance(obj, (tuple, list)):
+            items = enumerate(obj)
+        elif type(obj).__module__.startswith('tensorfold.') and hasattr(obj, '__dict__'):
+            items = vars(obj).items()
+        else:
+            return
+        for name, val in items:
+            # Communications own external storage and process state; CUDA allocator reconciliation below covers it.
+            if name in ('comm', 'torch', 'scheduler', 'request'):
+                continue
+            walk(val, category, f'{path}.{name}')
+    w = engine.w
+    walk(w.mtp, 'weights_mtp')
+    for name in ('embed', 'embedding', 'head'):
+        walk(getattr(w, name, None), 'weights_embedding_head')
+    for layer in w.layers:
+        moe = getattr(layer, 'moe', None)
+        walk(getattr(moe, 'experts', None), 'weights_experts')
+        walk(getattr(getattr(layer, 'dsa', None), 'cp_absorb', None), 'weights_cp_absorb_replicas')
+    walk(w, 'weights_dense_and_norms')
+    e = engine.e
+    walk(e.caches, 'kv_pool')
+    walk(engine.drafter, 'drafter')
+    walk(e.pbuf, 'prompt_chunk_buffers')
+    walk(e.buf, 'decode_buffers')
+    walk(e.mbuf, 'mtp_buffers')
+    walk(getattr(engine, 'multi', None), 'multi_buffers_and_drafter_contexts')
+    walk(e.graphs, 'graph_referenced_storage')
+    walk(engine, 'other_referenced_storage')
+    allocated, reserved = torch.cuda.memory_allocated(), torch.cuda.memory_reserved()
+    free, total = torch.cuda.mem_get_info()
+    pool_ids = set()
+    for handle in (getattr(e.graphs, 'pool', None),
+                   getattr(getattr(engine, 'multi', None), 'graph_pool', None)):
+        if handle is not None:
+            pool_ids.add(tuple(handle))
+    pools = {}
+    for segment in torch.cuda.memory_snapshot():
+        if segment.get('device', torch.cuda.current_device()) != torch.cuda.current_device():
+            continue
+        key = tuple(segment.get('segment_pool_id', (0, 0)))
