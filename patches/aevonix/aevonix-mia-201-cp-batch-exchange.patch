diff --git a/src/tensorfold/families/glm5_next/cuda/cp_batch.py b/src/tensorfold/families/glm5_next/cuda/cp_batch.py
new file mode 100644
index 00000000..a18b82fe
--- /dev/null
+++ b/src/tensorfold/families/glm5_next/cuda/cp_batch.py
@@ -0,0 +1,115 @@
+"""Concurrent CP transport, with one collective per phase for the whole layer.
+
+Each stream retains its selection and attention kernel calls, local token order,
+chunk size and rank-order merge. Only the transport's row dimension is packed.
+The paged reference stages twice; native page addressing can remove both copies.
+"""
+import torch
+
+
+def mix(verify, layer):
+    from . import dcp, dsa_full, latent
+    from .forward import cp_all_visible, cp_scratch, dsa_full_front, dsa_full_out, mm
+    from .paged_cp import run
+
+    w, b, R = verify.w, verify.b, verify.R
+    c, a = w.cfg, layer.dsa
+    G, rank, HP = int(w.meta['cp']), int(w.rank), int(w.meta['cp_heads'])
+    LW, RD, HL = c.kv_lora, c.rope, a.heads
+    freq = w.meta['rope_freq']
+    graph_buckets = getattr(verify, 'graph_buckets', None)
+    dynamic = graph_buckets is not None and getattr(verify, 'dynamic_extents', False)
+    dsa_full_front(layer, w, b, 0, R)
+    work, at = [], 0
+    for k, seg in enumerate(verify.segments):
+        st, n = seg.st, len(seg.tokens)
+        di = st.dsa_index[layer.index]
+        keys = None if st.index is None or a.index is None else st.index[st.index_of[layer.index]][2]
+        desc = verify.metadata[k, :2] if dynamic else None
+        pos = verify.metadata[k, 2:3] if dynamic else st.pos_dev
+        host = st.pos if graph_buckets is None else None
+        bucket = None if graph_buckets is None else graph_buckets[k]
+        within = ((host + n <= c.index_topk) if host is not None else bucket is None) and c.dense_limit <= c.index_topk
+        work.append((k, slice(at, at+n), n, st.kc[di], st.kr[di], keys, pos, host, bucket, desc, within))
+        at += n
+    # Graph verification preallocates this to the pool capacity. The eager path
+    # sizes it to the largest extent before any candidate buffer is retained.
+    largest = max((x[5] if x[5] is not None else x[3] for x in work), key=lambda x: x.shape[0])
+    sc = cp_scratch(w, b, largest)
+    selected = []
+
+    for k, rs, n, lc, kr, keys, pos, host, bucket, desc, within in work:
+        b.cp_graph_descriptor = desc
+
+        def prepare(layer, w, lc, kr, pos, b, n, keys, host, bucket):
+            latent.latent_write(b.lat[rs], lc, pos, cp=G, rank=rank)
+            dsa_full.k_rope_write(b.dp[rs, c.q_lora+c.kv_lora:], kr, pos, freq, cp=G, rank=rank, latent=lc)
+            dsa_full.q_rope(b.q[rs], b.qp[rs], pos, freq, c.nope)
+            ix = a.index
+            if ix is not None and keys is not None:
+                mm(b, b.normed[rs], ix.kw, b.xs[rs], b.ikr[rs])
+                dsa_full.index_write(b.ikr[rs, :c.index_dim], ix.ln_w, ix.ln_b, keys, pos, freq, cp=G, rank=rank)
+                if within:
+                    verify.topk[k] = tuple(t.clone() for t in cp_all_visible(w, b, n, pos, G, rank, c.index_topk))
+                else:
+                    mm(b, b.qr[rs], ix.qb, b.xs_qr[rs], b.qi[rs])
+                    dsa_full.index_q_rope(b.qi[rs], c.index_heads, pos, freq)
+                    cols = (max(1, dcp.visible_local(host+n-1, rank, G)) if host is not None else
+                            min(keys.shape[0], -(-int(bucket or c.dense_limit)//G)+1))
+                    dcp.select_local(b.qi[rs], b.ikr[rs, c.index_dim:], keys, rank, G, pos, n,
+                                     k=c.index_topk, cols=cols, out=sc.cand[rs], buf=sc.sel)
+                    selected.append((k, rs, n))
+            elif verify.topk[k] is None:
+                raise RuntimeError('shared indexer layer needs the preceding selection')
+            latent.absorb_q(b.q[rs], a.absorb, b.lat_s.qa[rs], prompt=False)
+
+        run(prepare, layer, w, lc, kr, pos, b, n, keys, host, bucket)
+
+    if selected:
+        # Dense and shared-index rows have no candidates; zero them so padding
+        # never transports uninitialized data. They are not merged below.
+        selected_keys = {k for k, _, _ in selected}
+        for k, rs, *_ in work:
+            if k not in selected_keys:
+                sc.cand[rs].zero_()
+        every = sc.every[:G*R*c.index_topk].view(G, R, c.index_topk)
+        w.comm.all_gather(sc.cand[:R].reshape(-1), every.reshape(-1))
+        for k, rs, n in selected:
+            verify.topk[k] = dcp.select_merge(every[:, rs].contiguous(), rank, G, c.index_topk)
+
+    mine = sc.mine[:R]
+    mine.zero_()
+    mine[:, :HL, :LW].copy_(b.lat_s.qa[:R])
+    mine[:, :HL, LW:].copy_(b.qp[:R])
+    allq = sc.allq[:G*R*HP*(LW+RD)]
+    w.comm.all_gather(mine.reshape(-1), allq)
+    allq = allq.view(G, R, HP, LW+RD).permute(1, 0, 2, 3)
+    sc.qa_all[:R].view(R, G, HP, LW).copy_(allq[..., :LW])
+    sc.qp_all[:R].view(R, G, HP, RD).copy_(allq[..., LW:])
+
+    for k, rs, n, lc, kr, keys, pos, host, bucket, desc, within in work:
+        b.cp_graph_descriptor = desc
+
+        def attend(layer, w, lc, kr, pos, b, n, keys, host, bucket):
+            tokens, counts = verify.topk[k]
+            dcp.attention_partial(sc.qa_all[rs], sc.qp_all[rs], lc, kr, tokens, counts, c.qk_dim**-0.5,
+                                  o=sc.o[rs], lse=sc.lse[rs], parts=sc.parts)
+
+        run(attend, layer, w, lc, kr, pos, b, n, None, host, bucket)
+
+    ob = sc.ob[:R]
+    ob.copy_(sc.o[:R])
+    so = sc.send_o[:G*R*HP*LW].view(G, R, HP, LW)
+    sl = sc.send_l[:G*R*HP].view(G, R, HP)
+    so.copy_(ob.view(R, G, HP, LW).permute(1, 0, 2, 3))
+    sl.copy_(sc.lse[:R].view(R, G, HP).permute(1, 0, 2))
+    got_o = sc.got_o[:G*R*HP*LW].view(G, R, HP, LW)
+    got_l = sc.got_l[:G*R*HP].view(G, R, HP)
+    got_o[rank].copy_(so[rank])
+    got_l[rank].copy_(sl[rank])
+    w.comm.exchange_all({p: [so[p], sl[p]] for p in range(G) if p != rank},
+                        {p: [got_o[p], got_l[p]] for p in range(G) if p != rank})
+    merged = dcp.merge_ranks(sc.got_f[:G*R*HP*LW].view(G, R, HP, LW).copy_(got_o), got_l,
+                              out=sc.merged[:R])
+    b.lat_s.ol[:R].copy_(merged[:, :HL])
+    return dsa_full_out(layer, w, b, R)
