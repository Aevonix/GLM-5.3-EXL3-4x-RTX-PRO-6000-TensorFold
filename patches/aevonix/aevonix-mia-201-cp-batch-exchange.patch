         if not latent.ENABLED:
             raise ValueError("batched verify windows need the latent cache (TF_GLM_LATENT=1)")
         if not 1 <= rows <= FULL_MAX_ROWS:
@@ -397,6 +400,10 @@ class FullBatchedVerify:
         if layer.kind != "dsa":
             raise ValueError(f"layer {layer.index}: full GLM-5.3 has attention layers only")
         w, b, R = self.w, self.b, self.R
+        if self.cp > 1 and self.batch_cp:
+            from .cp_batch import mix
+
+            return mix(self, layer)
         with prof.timed("dsa (total)"):
             dsa_full_front(layer, w, b, 0, R)
             at = 0
diff --git a/tests/test_cp_batch_exchange.py b/tests/test_cp_batch_exchange.py
new file mode 100644
index 00000000..214bd9d0
--- /dev/null
+++ b/tests/test_cp_batch_exchange.py
@@ -0,0 +1,71 @@
+"""Exercise batch row packing with deterministic transport and kernel stand-ins."""
+from types import SimpleNamespace as NS
+
+import torch
+from tensorfold.families.glm5_next.cuda import cp_batch, forward, latent, dsa_full, dcp
+from tensorfold.families.glm5_next.cuda.verify import Segment
+
+
+def test_collectives_pack_rows_once_and_preserve_segment_order(monkeypatch):
+    G, R, HP, LW, RD, K = 4, 5, 2, 2, 2, 2
+    calls = []
+    class Comm:
+        def all_gather(self, mine, every):
+            calls.append(('gather', mine.numel(), mine.dtype))
+            for g in range(G):
+                every.view(G,-1)[g].copy_(mine+g*10)
+        def exchange_all(self, sends, recvs):
+            calls.append(('exchange', len(sends)))
+            for p in sends:
+                for src,dst in zip(sends[p],recvs[p]):
+                    dst.copy_(src)
+    def empty(*shape,dtype=torch.float32):
+        return torch.empty(shape,dtype=dtype)
+    sc = NS(cand=empty(R,K,dtype=torch.int64),every=empty(G*R*K,dtype=torch.int64),sel=None,
+            mine=empty(R,HP,LW+RD),allq=empty(G*R*HP*(LW+RD)),qa_all=empty(R,G*HP,LW),
+            qp_all=empty(R,G*HP,RD),o=empty(R,G*HP,LW),lse=empty(R,G*HP),parts=None,
+            ob=empty(R,G*HP,LW),send_o=empty(G*R*HP*LW),send_l=empty(G*R*HP),
+            got_o=empty(G*R*HP*LW),got_l=empty(G*R*HP),got_f=empty(G*R*HP*LW),merged=empty(R,HP,LW))
+    cfg=NS(index_topk=K,dense_limit=K,q_lora=0,kv_lora=LW,rope=RD,nope=0,index_dim=2,index_heads=2,qk_dim=4)
+    w=NS(cfg=cfg,meta=dict(cp=G,cp_heads=HP,rope_freq=None),rank=0,comm=Comm())
+    a=NS(heads=HP,index=NS(kw=None,ln_w=None,ln_b=None,qb=None),absorb=None)
+    b=NS(prefill=False,lat=empty(R,LW),dp=empty(R,LW+RD),q=torch.arange(R*HP*LW).reshape(R,HP,LW).float(),
+         qp=torch.zeros(R,HP,RD),normed=empty(R,LW),xs=empty(R,LW),ikr=empty(R,4),
+         qr=empty(R,LW),xs_qr=empty(R,LW),qi=empty(R,LW),lat_s=NS(qa=empty(R,HP,LW),ol=empty(R,HP,LW)))
+    states=[NS(dsa_index={0:0},kc=[torch.full((32,2),float(v))],kr=[empty(32,2)],
+               index_of={0:0},index=[(None,None,empty(32,2))],pos=10,pos_dev=torch.tensor([10])) for v in (3,7)]
+    verify=NS(w=w,b=b,R=R,segments=[Segment(states[0],[1,2]),Segment(states[1],[3,4,5])],topk=[None,None])
+    monkeypatch.setattr(forward,'dsa_full_front',lambda *a:None)
+    monkeypatch.setattr(forward,'dsa_full_out',lambda layer,w,b,R:b.lat_s.ol[:R].clone())
+    monkeypatch.setattr(forward,'cp_scratch',lambda *a:sc)
+    monkeypatch.setattr(forward,'mm',lambda *a:None)
+    monkeypatch.setattr(latent,'latent_write',lambda *a,**kw:None)
+    monkeypatch.setattr(dsa_full,'k_rope_write',lambda *a,**kw:None)
+    monkeypatch.setattr(dsa_full,'q_rope',lambda q,qp,*a:qp)
+    monkeypatch.setattr(dsa_full,'index_write',lambda *a,**kw:None)
+    monkeypatch.setattr(dsa_full,'index_q_rope',lambda *a:None)
+    monkeypatch.setattr(latent,'absorb_q',lambda q,a,out,**kw:out.copy_(q))
+    def select(qi,wts,keys,rank,G,pos,n,*,out,**kw):
+        out.fill_(n)
+        return out
+    seen=[]
+    def merge(cands,rank,G,k):
+        seen.append(cands.clone())
+        return torch.zeros(cands.shape[1],k,dtype=torch.int32),torch.ones(cands.shape[1],dtype=torch.int32)
+    monkeypatch.setattr(dcp,'select_local',select)
+    monkeypatch.setattr(dcp,'select_merge',merge)
+    def partial(qa,qp,lc,kr,tokens,counts,scale,*,o,lse,parts):
+        o.copy_(qa+lc[0,0]);lse.zero_()
+        return o,lse
+    monkeypatch.setattr(dcp,'attention_partial',partial)
+    monkeypatch.setattr(dcp,'merge_ranks',lambda got,lse,out:out.copy_(got.mean(0)))
+    result=cp_batch.mix(verify,NS(index=0,dsa=a))
+    expected=b.q+15
+    expected[:2]+=3
+    expected[2:]+=7
+    assert torch.equal(result,expected)
+    assert [x[0] for x in calls] == ['gather','gather','exchange']
+    assert [tuple(x.shape) for x in seen] == [(4,2,2),(4,3,2)]
+    for n,cands in zip((2,3),seen):
+        for g in range(G):
+            assert torch.equal(cands[g],torch.full((n,K),n+10*g))
