diff --git a/tests/test_full_port_comm.py b/tests/test_full_port_comm.py
new file mode 100644
index 0000000..b6ce396
--- /dev/null
+++ b/tests/test_full_port_comm.py
@@ -0,0 +1,23 @@
+"""Rank-count and asymmetric exchange regressions, without a GPU."""
+import ctypes
+from types import SimpleNamespace
+import pytest
+
+torch = pytest.importorskip('torch')
+from tensorfold.cuda.comm import NCCL, BACKENDS
+
+@pytest.mark.parametrize('world,peer', [(2,1),(4,3)])
+def test_asymmetric_exchange_sends_and_receives_independently(monkeypatch,world,peer):
+    calls=[]
+    class Lib:
+        def ncclGroupStart(self): calls.append('start'); return 0
+        def ncclGroupEnd(self): calls.append('end'); return 0
+        def ncclSend(self,ptr,n,dtype,p,*args): calls.append(('send',n,dtype,p)); return 0
+        def ncclRecv(self,ptr,n,dtype,p,*args): calls.append(('recv',n,dtype,p)); return 0
+    c=NCCL.__new__(NCCL);c.rank=0;c.world=world;c.lib=Lib();c.comm=ctypes.c_void_p()
+    monkeypatch.setattr(torch.cuda,'current_stream',lambda:SimpleNamespace(cuda_stream=0))
+    c.exchange([torch.zeros(3),torch.zeros(0)],[torch.zeros(5),torch.zeros(2,dtype=torch.int32)],peer)
+    assert calls==['start',('send',3,7,peer),('recv',5,7,peer),('recv',2,2,peer),'end']
+
+def test_roce_backend_is_registered_without_building_or_opening_a_device():
+    assert callable(BACKENDS['roce'])
