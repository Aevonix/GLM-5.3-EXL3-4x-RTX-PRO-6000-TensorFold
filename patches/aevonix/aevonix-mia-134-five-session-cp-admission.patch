@@ -0,0 +1,12 @@
+import pytest
+
+from tensorfold.families.glm5_next.cuda.engine import parallel_limit
+
+
+@pytest.mark.parametrize('full,cp,enabled,expected', [
+    (True,4,'1',5), (True,4,'0',4), (True,1,'1',4),
+    (True,2,'1',4), (True,3,'1',4), (False,4,'1',4),
+])
+def test_five_stream_admission_is_limited_to_opted_in_full_cp4(monkeypatch,full,cp,enabled,expected):
+    monkeypatch.setenv('TF_GLM_CP_MULTI',enabled)
+    assert parallel_limit(full=full,cp=cp)==expected
