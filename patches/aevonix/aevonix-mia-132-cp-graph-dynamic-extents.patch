+
+@pytest.mark.parametrize('width', [64,132,304,528])
+@pytest.mark.parametrize('rank', range(4))
+def test_descriptor_changes_extent_without_changing_captured_view(width,rank):
+    data=(torch.arange(4097*width).reshape(4097,width)%113).to(torch.uint8)
+    arena=PagedArena(16384,[Plane(data,4,1)])
+    captured=arena.view(0,0,2048)
+    staged=torch.empty_like(data)
+    descriptor=torch.zeros(2,dtype=torch.int32)
+    pos=torch.zeros(1,dtype=torch.int32)
+    for base,size,n in [(0,2048,2039),(4096,8192,8190),(2048,4096,4079),(0,12288,10000)]:
+        actual=arena.view(0,base,size)
+        descriptor[:] = torch.tensor([base//4,actual.shape[0]])
+        pos.fill_(n)
+        position_copy(captured,staged,pos,9,4,rank,16384,descriptor=descriptor)
+        count=min(actual.shape[0],(n+12)//4+1)
+        assert torch.equal(staged[:count],actual.gather(count))
+        original=data.clone(); staged.fill_(37)
+        position_copy(captured,staged,pos,9,4,rank,16384,write=True,descriptor=descriptor)
+        lo=max(0,(n+3-rank)//4); hi=min(actual.shape[0],max(0,(n+12-rank)//4))
+        expected=original.clone()
+        expected.index_copy_(0,actual.indices(lo,hi-lo),staged[lo:hi])
+        assert torch.equal(data,expected)
