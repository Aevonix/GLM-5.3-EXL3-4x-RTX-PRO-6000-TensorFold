     return qmm.matmul(x, w, xs, f32=f32)
 
 
+def _embed(ids: torch.Tensor, w: Weights, out: torch.Tensor) -> None:
+    """The target embedding, replicated on Flash or vocabulary-sharded on full GLM.
+
+    Match DSpark and forward.embed_rows: rank-ordered fp32 parts contain exactly
+    one nonzero BF16 row per token, so their sum preserves the checkpoint row.
+    """
+    meta = getattr(w, "meta", None) or {}
+    if "embed_offset" not in meta:
+        glue.embed(ids, w.embed, out.shape[-1], 1, out)
+        return
+    from .dsa_full import embed_part
+
+    rows, width = out.shape
+    part = torch.empty((rows, width), dtype=torch.float32, device=out.device)
+    embed_part(ids, w.embed, meta["embed_offset"], part)
+    every = torch.empty((w.world * rows * width,), dtype=torch.float32, device=out.device)
+    if w.comm is not None:
+        w.comm.all_gather(part.reshape(-1), every)
+    elif w.world == 1:
+        every.copy_(part.reshape(-1))
+    else:
+        raise ValueError("sharded DFlash2 embedding requires the target communicator")
+    out.zero_()
+    glue.residual_add(out, out, every.view(w.world, rows, width))
+
+
 def merge_candidates(g: torch.Tensor, proj: torch.Tensor, k: int) -> tuple[np.ndarray, np.ndarray, np.ndarray]:
     """A block pass's host rows -> (ids [depth, k], logits, projected rows): ``g`` [ranks, depth, 2 * k] (each rank's
     top-k values, then ids as fp32 bits), merged by value then id over the ranks; ``proj`` [depth, selector rank]."""
