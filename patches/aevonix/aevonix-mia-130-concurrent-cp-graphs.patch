@@ -36,3 +36,42 @@ def copy(view, count, start, value=None, *, write=False):
         source.view(torch.uint8), target.view(torch.uint8), view.arena.table,
         view.base // plane.div, start, count, width, 2048 // plane.div, write, 1024)
     return value
+
+
+@tr.jit
+def _position_copy(SRC, DST, TABLE, POS, BASE,
+                   CAP: tl.constexpr, WIDTH: tl.constexpr, PAGE_ROWS: tl.constexpr,
+                   ROWS: tl.constexpr, CP: tl.constexpr, RANK: tl.constexpr,
+                   WRITE: tl.constexpr, BLOCK: tl.constexpr):
+    x = tl.program_id(0) * BLOCK + tl.arange(0, BLOCK)
+    pos = tl.load(POS)
+    row = x // WIDTH
+    if WRITE:
+        first = tl.maximum(0, (pos + CP - 1 - RANK) // CP)
+        last = tl.maximum(0, (pos + ROWS + CP - 1 - RANK) // CP)
+        row += first
+        valid = (row < last) & (row < CAP)
+    else:
+        last = tl.minimum(CAP, (pos + ROWS + CP - 1) // CP + 1)
+        valid = row < last
+    local = BASE + row
+    physical = tl.load(TABLE + local // PAGE_ROWS, valid, other=0) * PAGE_ROWS + local % PAGE_ROWS
+    mapped = physical * WIDTH + x % WIDTH
+    flat = row * WIDTH + x % WIDTH
+    source = flat if WRITE else mapped
+    target = mapped if WRITE else flat
+    value = tl.load(SRC + source, valid, other=0)
+    tl.store(DST + target, value, valid)
+
+
+def position_copy(view, value, pos_dev, rows, cp, rank, bound, *, write=False):
+    """Replay-safe raw copies: positions and page mappings remain device inputs."""
+    plane = view.arena.planes[view.plane]
+    if plane.div != cp or not value.is_contiguous() or not view.tensor.is_contiguous():
+        raise ValueError('position copies require contiguous CP planes')
+    width = view.tensor[0].numel() * view.tensor.element_size()
+    count = tr.cdiv(rows, cp) + 1 if write else min(view.shape[0], tr.cdiv(bound, cp) + 1)
+    source, target = (value, view.tensor) if write else (view.tensor, value)
+    _position_copy[(tr.cdiv(count * width, 1024),)](
+        source.view(torch.uint8), target.view(torch.uint8), view.arena.table, pos_dev,
+        view.base // cp, view.shape[0], width, 2048 // cp, rows, cp, rank, write, 1024)
