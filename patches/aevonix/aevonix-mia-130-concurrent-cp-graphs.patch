@@ -0,0 +1,83 @@
+"""Bounded lazy CUDA graphs for exact concurrent CP verification windows.
+
+Graph keys include every baked-in extent/slot, row count and selection bucket.
+Positions and physical page mappings remain mutable device inputs. Captures share
+one pool and execute sequentially, as do the existing single-request graphs.
+"""
+import os
+from collections import OrderedDict
+
+import torch
+
+from .verify import FullBatchedVerify, Verified
+
+
+class CPGraphVerify(FullBatchedVerify):
+    def __init__(self, e, *, taps=(), rows=16, pool=None):
+        super().__init__(e, taps=taps, rows=rows)
+        if self.cp <= 1:
+            raise ValueError('CP graphs require context parallelism')
+        self.pool = pool or torch.cuda.graph_pool_handle()
+        self.graphs = OrderedDict()
+        self.maximum = int(os.environ.get('TF_GLM_CP_MULTI_GRAPH_CACHE', '32'))
+        if self.maximum < 1:
+            raise ValueError('the CP graph cache must retain at least one graph')
+        self.replays = dict(graph=0, eager=0, captures=0, evictions=0)
+        self.graph_buckets = None
+        self.b.cp_graph_positions = True
+        self.b.paged_capacity = (e.caches.rows + self.cp - 1) // self.cp + 1
+        # All extents share this score allocation; later growth cannot invalidate
+        # scratch pointers embedded in a previously captured graph.
+        from .forward import CpScratch
+        self.b.cp_scratch = CpScratch(self.w, rows, self.b.paged_capacity, self.b.x.device)
+
+    @torch.no_grad()
+    def forward(self, segments):
+        from .dsa_full import bucket
+        from .forward import compute
+
+        self._check(segments)
+        # A window crossing the dense/sparse boundary retains the exact host path.
+        if any(s.st.pos < self.w.cfg.dense_limit < s.st.pos + len(s.tokens) for s in segments):
+            self.graph_buckets = None
+            self.replays['eager'] += 1
+            return super().forward(segments)
+        buckets = tuple(None if s.st.pos + len(s.tokens) <= self.w.cfg.dense_limit else
+                        bucket(s.st.pos, len(s.tokens), s.st.capacity) for s in segments)
+        key = tuple((s.st.graph_key, s.st.capacity, len(s.tokens), b) for s, b in zip(segments, buckets))
+        self._stage([t for s in segments for t in s.tokens])
+        self.segments = list(segments)
+        self.R = sum(len(s.tokens) for s in segments)
+        self.graph_buckets = buckets
+
+        def run():
+            self.topk = [None] * len(segments)
+            return compute(self.w, None, self.b, self.R, mixer=self._mixer)
+
+        item = self.graphs.pop(key, None)
+        if item is None:
+            if len(self.graphs) >= self.maximum:
+                torch.cuda.synchronize()
+                self.graphs.popitem(last=False)
+                self.replays['evictions'] += 1
+            # Writes repeat the same uncommitted rows; no positions or scheduler
+            # state advance until the caller accepts and commits the window.
+            for _ in range(2):
+                run()
+            torch.cuda.synchronize()
+            graph = torch.cuda.CUDAGraph()
+            with torch.cuda.graph(graph, pool=self.pool):
+                logits = run()
+            item = graph, logits
+            self.replays['captures'] += 1
+        self.graphs[key] = item
+        graph, logits = item
+        graph.replay()
+        self.replays['graph'] += 1
+        out, taps, at = [], [], 0
+        for seg in segments:
+            n = len(seg.tokens)
+            out.append(logits[at:at+n])
+            taps.append(torch.cat([t[at:at+n] for t in self.b.taps], dim=1) if self.taps else None)
+            at += n
+        return Verified(out, taps)
