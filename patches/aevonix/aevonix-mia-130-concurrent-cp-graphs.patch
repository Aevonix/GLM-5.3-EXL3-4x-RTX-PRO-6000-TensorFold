diff --git a/tests/test_cp_graph_copy.py b/tests/test_cp_graph_copy.py
new file mode 100644
index 00000000..b01f51be
--- /dev/null
+++ b/tests/test_cp_graph_copy.py
@@ -0,0 +1,27 @@
+import pytest
+import torch
+from tensorfold.families.glm5_next.cuda.pool import Plane
+from tensorfold.families.glm5_next.cuda.paged_cp import PagedArena
+from tensorfold.families.glm5_next.cuda.paged_copy import position_copy
+
+@pytest.mark.parametrize('width', [64,132,304,528])
+@pytest.mark.parametrize('rank', range(4))
+def test_dynamic_positions_page_edges_and_mapping_change(width,rank):
+    data=(torch.arange(2049*width).reshape(2049,width)%113).to(torch.uint8)
+    arena=PagedArena(8192,[Plane(data,4,1)])
+    view=arena.view(0,2048,4096)
+    staged=torch.empty_like(data[:1025]);pos=torch.tensor([0],dtype=torch.int32)
+    for n in [0,1,3,2039,2047,2048,4079]:
+        pos.fill_(n);rows=9;bound=4096
+        position_copy(view,staged,pos,rows,4,rank,bound)
+        count=min(view.shape[0],(n+rows+3)//4+1)
+        assert torch.equal(staged[:count],view.gather(count))
+        original=data.clone();staged.fill_(71)
+        position_copy(view,staged,pos,rows,4,rank,bound,write=True)
+        lo=max(0,(n+3-rank)//4);hi=max(0,(n+rows+3-rank)//4)
+        expected=original.clone();expected.index_copy_(0,view.indices(lo,hi-lo),staged[lo:hi])
+        assert torch.equal(data,expected)
+    arena.move(2048,0,4096)
+    view=arena.view(0,0,4096);pos.fill_(2051)
+    position_copy(view,staged,pos,9,4,rank,4096)
+    assert torch.equal(staged[:516],view.gather(516))
