+_f8_env = ("", {})
+def f8_tile(n: int, k: int):
+    import os
+    global _f8_env
+    value = os.environ.get("TF_GLM_F8_SHAPE_TILES", "")
+    if value != _f8_env[0]:
+        parsed = {}
+        for item in value.split(",") if value else ():
+            shape, config = item.split(":")
+            key = tuple(map(int, shape.split("x"))) if shape != "all" else "all"
+            bn, warps, stages = map(int, config.split("x"))
+            if (key != "all" and (len(key) != 2 or min(key) <= 0)) or bn not in (16, 32, 64, 128) or warps not in (4, 8) or stages not in (2, 3, 4, 6):
+                raise ValueError("TF_GLM_F8_SHAPE_TILES: NxK|all:BNxwarpsxstages")
+            parsed[key] = (bn, warps, stages)
+        _f8_env = value, parsed
+    return _f8_env[1].get((n, k), _f8_env[1].get("all"))
